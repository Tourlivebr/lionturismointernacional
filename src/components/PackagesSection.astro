---
import { siteConfig } from '../config/site';
import Icons from './Icons.astro';
---

<section id="pacotes" class="py-20 lg:py-28 bg-dark">
  <div class="container-page">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="flex items-center gap-3 justify-center mb-6">
        <div class="gold-line"></div>
        <span class="text-gold-400 text-sm tracking-[0.25em] uppercase font-medium">
          Nossos Pacotes
        </span>
        <div class="gold-line"></div>
      </div>
      <h2 class="section-title mb-6">
        Pacotes <span class="text-gradient-gold">personalizados</span>
      </h2>
      <p class="text-gray-400 text-lg">
        Diferentes opções para atender ao seu perfil, orçamento e estilo de viagem.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {siteConfig.packages.map((pkg) => (
        <article
          class={`relative rounded-sm border flex flex-col transition-all duration-300 ${
            pkg.highlight
              ? 'bg-dark-900 border-gold-500/50 shadow-2xl shadow-gold-500/10 lg:scale-105'
              : 'bg-dark-950 border-gold-500/10 hover:border-gold-500/30'
          }`}
        >
          {pkg.highlight && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold-500 text-dark px-4 py-1 text-xs font-bold uppercase tracking-wider">
              Mais popular
            </div>
          )}

          <div class="p-8 flex flex-col flex-1">
            <h3 class="text-2xl font-serif font-bold text-white mb-2">{pkg.title}</h3>
            <p class="text-gray-400 text-sm mb-6">{pkg.description}</p>

            <ul class="space-y-3 mb-8 flex-1">
              {pkg.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <span class="flex-shrink-0 w-5 h-5 rounded-full bg-gold-500/10 border border-gold-500/30 flex items-center justify-center mt-0.5">
                    <Icons name="check" class="w-3 h-3 text-gold-400" />
                  </span>
                  <span class="text-gray-300 text-sm">{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href={siteConfig.buttons.whatsapp.link}
              target="_blank"
              rel="noopener noreferrer"
              class={`btn w-full ${pkg.highlight ? 'btn-primary' : 'btn-secondary'}`}
            >
              {pkg.highlight ? siteConfig.buttons.buildPackage.label : siteConfig.buttons.requestService.label}
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-14 text-center">
      <p class="text-gray-400 mb-4">
        Precisa de um pacote diferente? Fale conosco e monte o seu.
      </p>
      <a href="#contato" class="btn btn-outline">
        {siteConfig.buttons.buildPackage.label}
      </a>
    </div>
  </div>
</section>

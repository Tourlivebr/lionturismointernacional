---
import { siteConfig } from '../config/site';
import Icons from './Icons.astro';

const navLinks = [
  { label: 'Início', href: '#topo' },
  { label: 'Quem Somos', href: '#quem-somos' },
  { label: 'Experiências', href: '#turismo' },
  { label: 'Como Funciona', href: '#grupo' },
  { label: 'Contato', href: '#contato' },
];
---

<header id="topo" class="sticky top-0 z-50">
  <div class="bg-gradient-to-b from-black/85 via-black/60 to-transparent backdrop-blur-sm border-b border-gold-500/15">
    <div class="container-page">
      <nav class="flex items-center justify-between h-20 lg:h-24" aria-label="Navegação principal">
        <a href="#topo" class="flex flex-col leading-none group">
          <span class="logo-script text-4xl sm:text-5xl lg:text-[3.3rem]">
            Lion Turismo
          </span>
          <span class="text-[0.65rem] sm:text-xs tracking-[0.35em] text-gold-300/90 font-medium pl-2 sm:pl-3 -mt-1">
            INTERNACIONAL
          </span>
        </a>

        <ul class="hidden lg:flex items-center gap-10">
          {navLinks.map((link, i) => (
            <li key={link.href}>
              <a
                href={link.href}
                class={`text-[0.95rem] transition-colors duration-300 relative pb-1 ${
                  i === 0
                    ? 'text-gold-400 after:absolute after:-bottom-0.5 after:left-0 after:w-full after:h-[2px] after:bg-gold-400'
                    : 'text-gray-200 hover:text-gold-400'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="flex items-center gap-4">
          <a
            href={siteConfig.buttons.buildPackage.link}
            class="hidden md:inline-flex btn btn-gold-outline !py-2.5 !px-5 text-sm rounded-md uppercase tracking-[0.15em]"
          >
            Monte seu pacote
          </a>

          <button
            id="menu-toggle"
            type="button"
            aria-label="Abrir menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="lg:hidden p-2.5 text-gold-400 hover:text-gold-300 border border-gold-500/30 rounded-md"
          >
            <Icons name="menu" class="w-6 h-6" id="icon-menu" />
            <Icons name="close" class="w-6 h-6 hidden" id="icon-close" />
          </button>
        </div>
      </nav>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-gold-500/10 bg-black/95 backdrop-blur-md"
  >
    <div class="container-page py-5 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-link px-4 py-3 text-gray-200 hover:text-gold-400 hover:bg-dark-800/70 rounded-md transition-colors text-base"
        >
          {link.label}
        </a>
      ))}
      <a
        href={siteConfig.buttons.buildPackage.link}
        class="mt-3 btn btn-gold-outline justify-center uppercase tracking-[0.15em]"
      >
        Monte seu pacote
      </a>
      <a
        href={siteConfig.buttons.whatsapp.link}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 btn btn-whatsapp justify-center"
      >
        <Icons name="whatsapp" class="w-5 h-5" />
        {siteConfig.buttons.whatsapp.label}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconMenu?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

---
import { siteConfig } from '../config/site';
import Icons from './Icons.astro';
---

<section id="quem-somos" class="py-20 lg:py-28 bg-dark">
  <div class="container-page">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div class="order-2 lg:order-1 space-y-6">
        <div class="flex items-center gap-3">
          <div class="gold-line"></div>
          <span class="text-gold-400 text-sm tracking-[0.25em] uppercase font-medium">
            Quem Somos
          </span>
        </div>

        <h2 class="section-title-gold">
          {siteConfig.about.title}
        </h2>

        <div class="space-y-4 text-gray-300 text-lg leading-relaxed">
          {siteConfig.about.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="pt-4 flex flex-col sm:flex-row gap-4">
          <a href="#turismo" class="btn btn-primary">
            {siteConfig.buttons.buildPackage.label}
          </a>
          <a href="#contato" class="btn btn-outline">
            {siteConfig.buttons.talkToLion.label}
          </a>
        </div>
      </div>

      <div class="order-1 lg:order-2 relative">
        <div class="relative w-full max-w-lg mx-auto lg:mx-0 lg:ml-auto">
          <div
            class="absolute -inset-3 bg-gradient-to-br from-gold-400/25 via-gold-600/10 to-transparent rounded-[2px] blur-xl opacity-70"
            aria-hidden="true"
          ></div>

          <div class="relative aspect-[4/5] w-full bg-dark-900">
            <img
              src={siteConfig.institutionalImage}
              alt={siteConfig.companyName}
              loading="lazy"
              class="w-full h-full object-contain drop-shadow-[0_25px_50px_rgba(0,0,0,0.5)]"
            />
          </div>

          <div class="absolute -bottom-6 -left-6 bg-dark border border-gold-500/30 p-6 shadow-xl hidden sm:block max-w-xs">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-gold-500/10 border border-gold-500/30 flex items-center justify-center flex-shrink-0">
                <Icons name="suitcase" class="w-6 h-6 text-gold-400" />
              </div>
              <div>
                <h4 class="font-serif text-gold-400 font-bold text-lg mb-1">
                  {siteConfig.slogan}
                </h4>
                <p class="text-sm text-gray-400">
                  Atendimento personalizado para cada perfil.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

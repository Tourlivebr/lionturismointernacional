---
import { siteConfig } from '../config/site';
import Icons from './Icons.astro';

const otherAreas = siteConfig.businessAreas.filter((a) => !a.highlighted);
---

<section id="grupo" class="py-20 lg:py-28 bg-dark-950 relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/20 to-transparent"></div>

  <div class="container-page relative">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="flex items-center gap-3 justify-center mb-6">
        <div class="gold-line"></div>
        <span class="text-gold-400 text-sm tracking-[0.25em] uppercase font-medium">
          O Grupo
        </span>
        <div class="gold-line"></div>
      </div>

      <h2 class="section-title mb-6">
        {siteConfig.sections.groupTitle}
      </h2>
      <p class="text-gray-400 text-lg leading-relaxed">
        {siteConfig.sections.groupSubtitle}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {otherAreas.map((area) => (
        <article class="group p-8 bg-dark border border-gold-500/10 hover:border-gold-500/40 transition-all duration-500 rounded-sm relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-gold-600 via-gold-400 to-gold-600 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>

          <div class="w-14 h-14 mb-6 rounded-sm bg-gold-500/10 border border-gold-500/20 flex items-center justify-center group-hover:bg-gold-500/20 group-hover:border-gold-500/40 transition-all">
            <Icons name={area.icon} class="w-7 h-7 text-gold-400" />
          </div>

          <h3 class="text-xl font-serif font-bold text-white mb-3">{area.title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">{area.description}</p>

          <a
            href="#contato"
            class="inline-flex items-center gap-2 text-gold-400 text-sm hover:text-gold-300 transition-colors"
          >
            Saiba mais
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

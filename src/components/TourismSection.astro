---
import Icons from './Icons.astro';
import { siteConfig } from '../config/site';

const highlights = [
  {
    title: 'Experiências Inesquecíveis',
    description:
      'Passeios guiados, gastronomia local, vinícolas, parques temáticos e muito mais para viver o melhor de Gramado.',
    image: 'img/Fotos-Jolimont.jpg',
  },
  {
    title: 'Hospedagem Premium',
    description:
      'Hóteis, pousadas e chalés selecionados, com opções para todos os perfis — de luxo a econômicas.',
    image: 'img/coline.png',
  },
  {
    title: 'Atendimento Familiar',
    description:
      'Atendimento próximo, humano e dedicado. Tratamos cada cliente como parte da nossa família.',
    image: 'img/atende_familiar.jpg',
  },
];
---

<section id="turismo" class="py-20 lg:py-28 bg-dark-950 relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/20 to-transparent"></div>

  <div class="container-page relative">
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
      <div class="flex items-center gap-3 justify-center mb-6">
        <div class="gold-line"></div>
        <span class="text-gold-400 text-sm tracking-[0.25em] uppercase font-medium">
          Turismo em Gramado
        </span>
        <div class="gold-line"></div>
      </div>

      <h2 class="section-title mb-6">
        Viva a magia da <span class="text-gradient-gold">Serra Gaúcha</span>
      </h2>
      <p class="text-gray-400 text-lg leading-relaxed">
        Pacotes personalizados, atendimento dedicado e a certeza de uma viagem inesquecível para você e sua família.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {highlights.map((item, i) => (
        <article
          class={`group relative bg-dark border border-gold-500/10 hover:border-gold-500/30 transition-all duration-500 rounded-sm overflow-hidden ${
            i === 1 ? 'lg:-translate-y-4' : ''
          }`}
        >
          <div class="aspect-[5/4] overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
          </div>
          <div class="p-6 sm:p-8">
            <h3 class="text-xl font-serif font-bold text-gold-400 mb-3">
              {item.title}
            </h3>
            <p class="text-gray-400 leading-relaxed mb-5">{item.description}</p>
            <a
              href={siteConfig.buttons.buildPackage.link}
              class="inline-flex items-center gap-2 text-sm text-gold-400 hover:text-gold-300 transition-colors"
            >
              {siteConfig.buttons.buildPackage.label}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-28">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <div class="flex items-center gap-3 justify-center mb-6">
          <div class="gold-line"></div>
          <span class="text-gold-400 text-sm tracking-[0.25em] uppercase font-medium">
            {siteConfig.cityTour.title}
          </span>
          <div class="gold-line"></div>
        </div>
        <h2 class="section-title mb-6">
          Frota completa para <span class="text-gradient-gold">todos os perfis</span>
        </h2>
        <p class="text-gray-400 text-lg leading-relaxed mb-6">
          {siteConfig.cityTour.subtitle}
        </p>
        <div class="inline-flex flex-wrap gap-3 justify-center">
          {siteConfig.cityTour.freePerks.map((perk) => (
            <span class="inline-flex items-center gap-2 px-4 py-2 bg-gold-500/10 border border-gold-500/30 text-gold-400 text-sm font-medium rounded-full">
               {perk}
            </span>
          ))}
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-dark border border-gold-500/20 text-gray-300 text-sm rounded-full">
            <Icons name="map-pin" class="w-4 h-4 text-gold-400" />
            {siteConfig.cityTour.region}
          </span>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {siteConfig.cityTour.vehicles.map((vehicle) => (
          <article class="group p-6 bg-dark border border-gold-500/10 hover:border-gold-500/40 transition-all duration-300 rounded-sm relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-28 h-28 bg-gold-500/5 rounded-full blur-2xl group-hover:bg-gold-500/10 transition-colors"></div>
            <div class="relative">
              <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-full bg-gold-500/10 border border-gold-500/25 flex items-center justify-center group-hover:bg-gold-500/20 transition-colors">
                  <Icons name={vehicle.icon} class="w-6 h-6 text-gold-400" />
                </div>
              </div>
              <h3 class="font-serif text-lg font-bold text-white mb-2">
                {vehicle.name}
              </h3>
              <p class="text-sm text-gray-400 leading-relaxed">
                {vehicle.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-20 relative">
      <div class="absolute inset-0 rounded-sm bg-gradient-to-r from-gold-600/10 via-gold-500/20 to-gold-600/10 p-[1px]">
        <div class="w-full h-full bg-dark-950 rounded-sm"></div>
      </div>
      <div class="relative p-8 sm:p-10 lg:p-12 rounded-sm bg-dark-950/60 backdrop-blur-sm border border-gold-500/15">
        <div class="grid lg:grid-cols-5 gap-10 items-center">
          <div class="lg:col-span-3 space-y-5">
            <div class="flex items-center gap-3">
              
              <span class="text-gold-400 text-sm tracking-[0.2em] uppercase font-medium">
                Facilidade de pagamento
              </span>
            </div>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-white leading-tight">
              {siteConfig.ticketsAndInstallments.title}
            </h3>
            <p class="text-gray-400 text-base sm:text-lg leading-relaxed max-w-xl">
              {siteConfig.ticketsAndInstallments.subtitle}
            </p>
            <ul class="flex flex-wrap gap-3 pt-2">
              {siteConfig.ticketsAndInstallments.items.map((it) => (
                <li class="inline-flex items-center gap-2 px-4 py-2 bg-dark border border-gold-500/20 rounded-full text-sm text-gray-200">
                  <Icons name="check" class="w-4 h-4 text-gold-400" />
                  {it}
                </li>
              ))}
            </ul>
          </div>
          <div class="lg:col-span-2">
            <div class="relative p-6 sm:p-8 rounded-sm border border-gold-500/30 bg-gradient-to-br from-gold-500/10 via-dark to-dark/80">
              <div class="absolute -top-3 -right-3 bg-gold-500 text-dark px-4 py-1.5 text-xs font-bold uppercase tracking-wider shadow-lg shadow-gold-500/20 rounded-sm">
                Condição exclusiva
              </div>
              <div class="space-y-4">
                <div class="flex items-center gap-4">
                  <span class="text-4xl sm:text-5xl">💳</span>
                  <div>
                    <p class="text-xs text-gold-400/80 tracking-widest uppercase font-medium">
                      Parcele em
                    </p>
                    <p class="text-3xl sm:text-4xl font-serif font-bold text-gold-400 leading-tight">
                      48x
                    </p>
                  </div>
                </div>
                <p class="text-white font-semibold text-lg sm:text-xl">
                  {siteConfig.ticketsAndInstallments.installments}
                </p>
                <a
                  href={siteConfig.buttons.whatsapp.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary w-full mt-4"
                >
                  <Icons name="whatsapp" class="w-5 h-5" />
                  Consultar condições
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 text-center">
      <div class="inline-flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={siteConfig.buttons.whatsapp.link}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <Icons name="whatsapp" class="w-5 h-5" />
          {siteConfig.buttons.whatsapp.label}
        </a>
        <a href={siteConfig.buttons.whatsapp.link} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          {siteConfig.buttons.buildPackage.label}
        </a>
      </div>
    </div>
  </div>
</section>

---
import { siteConfig } from '../config/site';
import Icons from './Icons.astro';
---

<section id="contato" class="py-20 lg:py-28 bg-dark relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/20 to-transparent"></div>
  <div class="absolute -top-20 -right-20 w-96 h-96 bg-gold-500/5 rounded-full blur-3xl"></div>

  <div class="container-page relative">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="flex items-center gap-3 justify-center mb-6">
        <div class="gold-line"></div>
        <span class="text-gold-400 text-sm tracking-[0.25em] uppercase font-medium">
          Fale Conosco
        </span>
        <div class="gold-line"></div>
      </div>
      <h2 class="section-title mb-6">
        Vamos conversar sobre sua <span class="text-gradient-gold">próxima viagem</span>
      </h2>
      <p class="text-gray-400 text-lg leading-relaxed">
        Atendimento rápido e personalizado pelo WhatsApp ou e-mail. Estamos prontos para ajudar!
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8 max-w-6xl mx-auto">
      <div class="lg:col-span-3 space-y-6">
        <a
          href={siteConfig.contact.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="block p-6 sm:p-8 bg-dark-950 border border-gold-500/20 hover:border-green-500/40 transition-all duration-300 rounded-sm group"
        >
          <div class="flex items-start gap-5">
            <div class="w-14 h-14 rounded-full bg-green-600/10 border border-green-500/30 flex items-center justify-center flex-shrink-0 group-hover:bg-green-600/20 transition-colors">
              <Icons name="whatsapp" class="w-7 h-7 text-green-500" />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-serif font-bold text-white mb-1">
                {siteConfig.buttons.whatsapp.label}
              </h3>
              <p class="text-2xl text-green-500 font-semibold mb-2">
                {siteConfig.contact.whatsapp}
              </p>
              <p class="text-sm text-gray-400">
                Resposta rápida. Atendimento humanizado e personalizado.
              </p>
            </div>
          </div>
        </a>

        <a
          href={`mailto:${siteConfig.contact.email}`}
          class="block p-6 sm:p-8 bg-dark-950 border border-gold-500/20 hover:border-gold-500/40 transition-all duration-300 rounded-sm group"
        >
          <div class="flex items-start gap-5">
            <div class="w-14 h-14 rounded-full bg-gold-500/10 border border-gold-500/30 flex items-center justify-center flex-shrink-0 group-hover:bg-gold-500/20 transition-colors">
              <Icons name="mail" class="w-7 h-7 text-gold-400" />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-serif font-bold text-white mb-1">E-mail</h3>
              <p class="text-lg text-gold-400 mb-2 break-all">
                {siteConfig.contact.email}
              </p>
              <p class="text-sm text-gray-400">
                Envie sua mensagem a qualquer momento. Respondemos em breve.
              </p>
            </div>
          </div>
        </a>

        <a
          href={siteConfig.contact.instagramLink}
          target="_blank"
          rel="noopener noreferrer"
          class="block p-6 sm:p-8 bg-dark-950 border border-gold-500/20 hover:border-pink-500/40 transition-all duration-300 rounded-sm group"
        >
          <div class="flex items-start gap-5">
            <div class="w-14 h-14 rounded-full bg-pink-600/10 border border-pink-500/30 flex items-center justify-center flex-shrink-0 group-hover:bg-pink-600/20 transition-colors">
              <Icons name="instagram" class="w-7 h-7 text-pink-400" />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-serif font-bold text-white mb-1">Instagram</h3>
              <p class="text-lg text-pink-400 mb-2">
                {siteConfig.contact.instagram}
              </p>
              <p class="text-sm text-gray-400">
                Acompanhe nossos conteúdos, dicas de viagem e novidades.
              </p>
            </div>
          </div>
        </a>
      </div>

      <aside class="lg:col-span-2">
        <div class="sticky top-28 p-8 bg-dark-950 border border-gold-500/20 rounded-sm">
          <div class="flex items-center gap-2 mb-6">
            <Icons name="map-pin" class="w-5 h-5 text-gold-400" />
            <h3 class="font-serif text-xl font-bold text-white">Localização</h3>
          </div>
          <p class="text-gray-300 leading-relaxed">
            {siteConfig.contact.address}
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

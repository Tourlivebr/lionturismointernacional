---
import { siteConfig } from '../config/site';
import Icons from './Icons.astro';
---

<section id="hero" class="relative min-h-[55vh] sm:min-h-[70vh] lg:min-h-[75vh] flex items-center overflow-hidden bg-black">
  <img
    src={siteConfig.hero.backgroundImage}
    alt="Lion Turismo Internacional - Gramado e Serra Gaúcha"
    class="absolute inset-0 w-full h-full object-cover object-center lg:object-right"
    priority
  />

  <div class="absolute inset-0 bg-gradient-to-r from-black via-black/85 to-black/20"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/10 to-transparent"></div>
  <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-black/40 via-black/10 to-transparent hidden md:block"></div>

  <div
    class="absolute bottom-0 left-0 right-0 pointer-events-none"
    aria-hidden="true"
  >
    <svg class="w-full h-auto block" viewBox="0 0 1920 320" preserveAspectRatio="none" fill="none">
      <defs>
        <linearGradient id="goldSweep1" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#FFB627" stop-opacity="0"></stop>
          <stop offset="20%" stop-color="#FFCB4C" stop-opacity="0.85"></stop>
          <stop offset="45%" stop-color="#FFE08A" stop-opacity="1"></stop>
          <stop offset="65%" stop-color="#FFCB4C" stop-opacity="0.85"></stop>
          <stop offset="100%" stop-color="#E5A01A" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient id="goldSweep2" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#FFB627" stop-opacity="0"></stop>
          <stop offset="30%" stop-color="#E5A01A" stop-opacity="0.5"></stop>
          <stop offset="55%" stop-color="#FFCB4C" stop-opacity="0.7"></stop>
          <stop offset="80%" stop-color="#E5A01A" stop-opacity="0.4"></stop>
          <stop offset="100%" stop-color="#FFB627" stop-opacity="0"></stop>
        </linearGradient>
        <filter id="glow1" x="-20%" y="-100%" width="140%" height="400%">
          <feGaussianBlur stdDeviation="6" result="blur"/>
          <feMerge>
            <feMergeNode in="blur"/>
            <feMergeNode in="SourceGraphic"/>
          </feMerge>
        </filter>
        <filter id="glow2" x="-20%" y="-100%" width="140%" height="400%">
          <feGaussianBlur stdDeviation="10" result="blur"/>
          <feMerge>
            <feMergeNode in="blur"/>
            <feMergeNode in="SourceGraphic"/>
          </feMerge>
        </filter>
      </defs>

      <path
        d="M0 260 C 380 140, 760 300, 1140 180 S 1920 240, 1920 240"
        stroke="url(#goldSweep1)"
        stroke-width="3"
        fill="none"
        filter="url(#glow1)"
        stroke-linecap="round"
      />
      <path
        d="M0 295 C 420 190, 820 320, 1200 215 S 1920 285, 1920 285"
        stroke="url(#goldSweep2)"
        stroke-width="2"
        fill="none"
        filter="url(#glow2)"
        stroke-linecap="round"
        opacity="0.8"
      />
      <path
        d="M0 315 C 500 220, 900 340, 1300 240 S 1920 310, 1920 310"
        stroke="url(#goldSweep1)"
        stroke-width="1.2"
        fill="none"
        filter="url(#glow1)"
        stroke-linecap="round"
        opacity="0.6"
      />
    </svg>
  </div>

  <div class="container-page relative z-10 pb-6 pt-6 md:pt-10 md:pb-14 lg:pt-16 lg:pb-18">
    <div class="max-w-3xl">
      <div class="flex items-center gap-4 mb-4 md:mb-5">
        <span class="text-gold-300 text-xs md:text-sm tracking-[0.35em] uppercase font-semibold">
          {siteConfig.hero.eyebrow}
        </span>
        <span class="h-[2px] w-16 md:w-24 bg-gradient-to-r from-gold-400/90 via-gold-400/60 to-transparent"></span>
      </div>

      <h1 class="font-serif font-bold text-white leading-[0.95] mb-4 md:mb-5">
        <span class="block text-[2.2rem] sm:text-5xl md:text-6xl lg:text-[4.6rem] tracking-tight">
          {siteConfig.hero.titlePrimary}
        </span>
        <span class="block text-[2.2rem] sm:text-5xl md:text-6xl lg:text-[4.6rem] tracking-tight text-gradient-gold">
          {siteConfig.hero.titleSecondary}
        </span>
      </h1>

      <p class="text-base md:text-lg text-gray-300 leading-relaxed max-w-2xl">
        {siteConfig.hero.subtitle}
      </p>
    </div>
  </div>

  <a
    href="#quem-somos"
    aria-label="Rolar para próxima seção"
    class="hidden md:flex absolute bottom-6 right-8 z-10 w-11 h-11 rounded-full border border-gold-400/40 items-center justify-center text-gold-400 hover:bg-gold-500/10 transition-colors animate-bounce"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </a>

  <a
    href={siteConfig.buttons.whatsapp.link}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chamar no WhatsApp"
    class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-600 hover:bg-green-500 text-white rounded-full shadow-2xl shadow-green-600/40 flex items-center justify-center transition-all hover:scale-110 border-2 border-green-400/40"
  >
    <Icons name="whatsapp" class="w-7 h-7" />
  </a>
</section>
